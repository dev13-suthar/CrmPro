// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int  @id @default(autoincrement())
  email         String @unique
  Name          String
  password      String

  accessToken          String?  // Store the access token
  resetToken           String?
  resetTokenExpiry     DateTime?
  refreshToken         String?  // Store the refresh token
  tokenExpiry          DateTime?
  updatemailToken      String?
  updateMailTokenExpiry DateTime?
  
  userplan      UserPlan? 
  WorkSpace     WorkSpace?
}

model WorkSpace{
  id        Int  @id @default(autoincrement())
  name      String
  adminId   Int  @unique
  blockExpires   DateTime?  //Free Workspace users can send only brodcast in 7 days,

  admin     User @relation(fields: [adminId],references: [id])

  people    People[] 
  safeDocs  safeDoc[]
  tasks     Task[]
  brodcasts BrodCast[]
}

model safeDoc{
  id          String  @id @default(cuid())
  shareId     String  @unique @default(nanoid())
  name        String
  url         String  @unique
  createdAt   DateTime @default(now())
  workspaceId Int
  Workspace   WorkSpace @relation(fields: [workspaceId],references: [id])
}

model UserPayments{
  id                Int   @id @default(autoincrement())
  userId            Int
  orderId           String @unique
  paymentId         String?
  amount            Int
  email             String?
  orderstatus       OrderStatus @default(created) @map("Order_Status")
  createdAt         DateTime @default(now())
}

model UserPlan{
  id            String  @id @default(uuid())
  userId        Int     @unique
  planStatus    plans   @default(Free)
  planExpires   DateTime?
  User          User    @relation(fields: [userId],references: [id])
}

model People{
  id            Int  @id @default(autoincrement())
  name          String
  company       String
  phone         String?
  email         String?
  city          String?
  jobTitle      String?
  workSpaceId   Int
  workSpace     WorkSpace @relation(fields: [workSpaceId],references: [id])
  task          Task[]
}

model Task{
  id          Int @id @default(autoincrement())
  title       String
  dueDate     DateTime? 
  assigneeId  Int
  workSpaceId Int
  staus       status @default(Todo)
  workSpace   WorkSpace @relation(fields: [workSpaceId],references: [id])
  assginee    People @relation(fields: [assigneeId],references: [id])
}

model BrodCast{
  id             String @id @default(cuid())
  mailId         String
  workSpaceId    Int
  workspace      WorkSpace @relation(fields: [workSpaceId],references: [id])
  @@unique([mailId])
}

enum status{
  InProgress
  Completed
  Todo
}

enum OrderStatus{
  created
  success
  fail
}

enum plans{
  Free
  Plus
}

